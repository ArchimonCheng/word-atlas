# 复制为 .env 后填入真实值；.env 已被 .gitignore 排除
# 开放平台 Access Secret：https://developer.zhihu.com/profile
ZHIHU_ACCESS_SECRET=

# 以下三项由黑客松活动页面创建项目后分配（不填则登录入口停用，词汇分析仍可用）
ZHIHU_OAUTH_APP_ID=
ZHIHU_OAUTH_APP_KEY=
# 必须与活动页面登记值完全一致，包括协议、域名、路径和尾部斜杠
ZHIHU_OAUTH_REDIRECT_URI=https://your-domain/auth/callback

# 监听配置：默认仅回环。对外暴露需置于反向代理之后再设 HOST=0.0.0.0
HOST=127.0.0.1
PORT=8787

# Access Secret 也可不在此配置，改为让用户在页面上方 🔑 自填（按用户额度计）。
# 此处的 ZHIHU_ACCESS_SECRET 作为未自填时的回退（部署者共享额度）。

# 会话 Cookie 的 Secure 属性。留空则跟随上面回调地址的协议：
#   https:// 回调 -> 自动开启      http:// 或未填 -> 关闭（本地调试可用）
# 应用自身跑 http、由反向代理终止 TLS 时必须显式置 1。
# 注意：本地 http 下强开会让浏览器丢弃 cookie，登录表现为「点了没反应」。
COOKIE_SECURE=
